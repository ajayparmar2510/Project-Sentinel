:root {
    --bg: #080D19;
    --surface: #101827;
    --surface-2: #151F32;
    --surface-3: #1A2740;
    --border: #263650;
    --text: #F0F5FF;
    --muted: #A0B0CA;
    --blue: #6595FF;
    --teal: #3DD9C5;
    --purple: #B49AFF;
    --red: #FF7188;
    --amber: #FFC875;
}

.stApp {
    background:
        radial-gradient(ellipse at 85% 0%, rgba(55, 103, 190, .13), transparent 36%),
        var(--bg);
    color: var(--text);
}

[data-testid="stHeader"] {
    background: rgba(8, 13, 25, .94);
    border-bottom: 1px solid var(--border);
}

[data-testid="stAppViewContainer"] > .main .block-container {
    max-width: 1500px;
    padding-top: 2rem;
    padding-bottom: 4rem;
}

[data-testid="stSidebar"] {
    background: linear-gradient(180deg, #101827 0%, #0B1220 100%);
    border-right: 1px solid var(--border);
}

[data-testid="stSidebar"] > div:first-child {
    padding-top: 1.5rem;
}

[data-testid="stSidebar"] h1,
[data-testid="stSidebar"] h2,
[data-testid="stSidebar"] h3,
[data-testid="stSidebar"] p,
[data-testid="stSidebar"] label,
[data-testid="stSidebar"] span,
[data-testid="stSidebar"] [data-testid="stMarkdownContainer"] {
    color: var(--text) !important;
}

[data-testid="stSidebar"] [data-testid="stRadio"] label {
    padding: .55rem .7rem;
    border-radius: 9px;
}

[data-testid="stSidebar"] [data-testid="stRadio"] label:hover {
    background: rgba(101, 149, 255, .10);
}

h1, h2, h3, h4 {
    color: var(--text) !important;
    letter-spacing: -.025em;
}

p, li, label, .stMarkdown, [data-testid="stCaptionContainer"] {
    color: var(--muted);
}

[data-testid="stCaptionContainer"] p {
    color: var(--muted) !important;
}

.sentinel-hero {
    position: relative;
    overflow: hidden;
    padding: 2rem 2.2rem;
    margin-bottom: 1.5rem;
    border: 1px solid #2D4365;
    border-radius: 20px;
    background:
        radial-gradient(ellipse at 100% 0%, rgba(80, 126, 255, .22), transparent 45%),
        linear-gradient(120deg, #121E33 0%, #101827 60%, #14213A 100%);
    box-shadow: 0 18px 55px rgba(0, 0, 0, .22);
}

.sentinel-eyebrow {
    color: var(--teal) !important;
    font-size: .76rem;
    font-weight: 800;
    letter-spacing: .16em;
    text-transform: uppercase;
}

.sentinel-hero-title {
    color: #F5F8FF !important;
    font-size: clamp(2.1rem, 4vw, 3.25rem);
    font-weight: 850;
    letter-spacing: -.055em;
    line-height: 1.15;
    margin: .65rem 0;
}

.sentinel-hero-copy {
    color: #B9C8E0 !important;
    font-size: 1rem;
    line-height: 1.75;
    max-width: 900px;
}

[data-testid="stMetric"] {
    padding: 1.15rem 1.2rem;
    background: linear-gradient(145deg, #151F32, #101827);
    border: 1px solid var(--border);
    border-radius: 15px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, .12);
}

[data-testid="stMetricLabel"] {
    color: #AFC0DB !important;
    font-size: .85rem;
}

[data-testid="stMetricValue"] {
    color: #F4F7FF !important;
    font-weight: 800;
    letter-spacing: -.035em;
}

[data-testid="stMetricDelta"] {
    color: var(--teal) !important;
}

.stProgress > div > div > div > div {
    background: linear-gradient(90deg, #477DFF, #3DD9C5);
}

.stProgress > div > div {
    background: #25334A;
}

[data-testid="stVerticalBlockBorderWrapper"] {
    border-color: var(--border) !important;
    border-radius: 15px;
}

.stTabs [data-baseweb="tab-list"] {
    gap: .45rem;
    border-bottom: 1px solid var(--border);
}

.stTabs [data-baseweb="tab"] {
    color: var(--muted);
    padding: .8rem 1rem;
}

.stTabs [aria-selected="true"] {
    color: var(--blue) !important;
    border-bottom-color: var(--blue) !important;
}

.stButton > button,
.stDownloadButton > button {
    color: #F7FAFF;
    background: linear-gradient(135deg, #356BE8, #4A85F7);
    border: 1px solid #6294FF;
    border-radius: 10px;
    font-weight: 650;
    transition: all .18s ease;
}

.stButton > button:hover,
.stDownloadButton > button:hover {
    color: #FFFFFF;
    border-color: #8CB0FF;
    box-shadow: 0 5px 22px rgba(66, 119, 255, .22);
    transform: translateY(-1px);
}

[data-baseweb="select"] > div,
[data-baseweb="input"] > div,
[data-baseweb="textarea"] > div {
    background: #111B2D !important;
    border-color: #344762 !important;
    border-radius: 10px !important;
}

[data-baseweb="select"] *,
[data-baseweb="input"] input,
[data-baseweb="textarea"] textarea {
    color: var(--text) !important;
}

[data-baseweb="popover"],
[data-baseweb="menu"] {
    background: #151F32 !important;
    border: 1px solid var(--border) !important;
}

[data-baseweb="menu"] * {
    color: var(--text) !important;
}

[data-testid="stDataFrame"],
[data-testid="stTable"] {
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
}

[data-testid="stPlotlyChart"] {
    background: #101827;
    border: 1px solid var(--border);
    border-radius: 15px;
    padding: 8px;
}

[data-testid="stAlert"] {
    background: #121E31;
    border: 1px solid #304765;
    border-radius: 12px;
}

[data-testid="stExpander"] {
    background: #101827;
    border: 1px solid var(--border);
    border-radius: 12px;
}

[data-testid="stExpander"] summary,
[data-testid="stExpander"] summary p {
    color: var(--text) !important;
}

.sentinel-panel {
    padding: 1.35rem 1.5rem;
    background: linear-gradient(145deg, #141F32, #101827);
    color: #DCE7FA;
    border: 1px solid #2B3D59;
    border-left: 3px solid var(--blue);
    border-radius: 13px;
    line-height: 1.85;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
}

.sentinel-insight {
    padding: 1rem 1.15rem;
    margin: .55rem 0;
    background: #121E30;
    border: 1px solid #2B405D;
    border-radius: 12px;
    color: #DCE7FA;
    line-height: 1.7;
}

.sentinel-insight-title {
    color: #F2F6FF;
    font-weight: 750;
    margin-bottom: .35rem;
}

.sentinel-muted {
    color: var(--muted) !important;
}

hr {
    border-color: var(--border) !important;
}

a {
    color: #8DB0FF !important;
}

@media (max-width: 768px) {
    [data-testid="stAppViewContainer"] > .main .block-container {
        padding: 1rem .8rem 2rem;
    }

    .sentinel-hero {
        padding: 1.35rem;
        border-radius: 15px;
    }

    .sentinel-hero-title {
        font-size: 2rem;
    }
}
